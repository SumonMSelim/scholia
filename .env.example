# Sanity (public)
NEXT_PUBLIC_SANITY_PROJECT_ID=dqd1lxzm
NEXT_PUBLIC_SANITY_DATASET=production
# Sanity org token with Context Viewer permission (server only)
SANITY_ORGANIZATION_TOKEN=
# Context MCP endpoint, knowledge_base mode
SANITY_CONTEXT_MCP_URL=
# Project token with Editor role, used by ingest scripts and save-web-reference
SANITY_WRITE_TOKEN=
# Tavily (trusted web fallback)
TAVILY_API_KEY=
# AWS (Bedrock + Transcribe), us-east-1
AWS_REGION=us-east-1
BEDROCK_MODEL_AGENT=us.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_FAST=us.amazon.nova-micro-v1:0
BEDROCK_MODEL_EMBED=amazon.titan-embed-text-v2:0
